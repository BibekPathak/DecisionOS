# DecisionOS example environment. Copy to `.env` and adjust.
# NEVER commit real secrets. This file must contain no credentials.

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Leave empty in development to disable API key authentication.
API_KEY=
MAX_CONTEXT_BYTES=65536

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://decisionos:decisionos@postgres:5432/decisionos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=600

# --- Providers -------------------------------------------------------------
# `mock` runs DecisionOS without any external credentials.
DEFAULT_PROVIDER=mock

# --- Jev / TypeSafe --------------------------------------------------------
# The primary provider. Leave the key empty to fall back to MockProvider.
# Values may also be supplied under the TYPESAFE_* names.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=10
JEV_MAX_RETRIES=3
JEV_BACKOFF_BASE_SECONDS=0.5
JEV_BACKOFF_MAX_SECONDS=8

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=decisionos-api
METRICS_ENABLED=true
TRACE_SAMPLE_RATIO=1.0
