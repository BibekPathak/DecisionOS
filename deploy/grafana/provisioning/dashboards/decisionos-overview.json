{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "DecisionOS",
  "uid": "decisionos-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["decisionos"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(decisionos_decisions_total, provider)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "decision_type",
        "label": "Decision type",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(decisionos_decisions_total, decision_type)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Decisions (rate)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(decisionos_decisions_total{provider=~\"$provider\",decision_type=~\"$decision_type\"}[5m]))",
          "legendFormat": "decisions/s"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Action distribution (5m)",
      "gridPos": { "h": 4, "w": 10, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (action) (increase(decisionos_decisions_total{provider=~\"$provider\",decision_type=~\"$decision_type\"}[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Calibration ECE",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(decisionos_calibration_error)",
          "legendFormat": "ECE"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Decision latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le,provider) (rate(decisionos_decision_latency_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le,provider) (rate(decisionos_decision_latency_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p95 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le,provider) (rate(decisionos_decision_latency_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p99 {{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,provider) (rate(decisionos_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p95 {{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider errors by kind",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (error) (rate(decisionos_provider_errors_total{provider=~\"$provider\"}[5m]))",
          "legendFormat": "{{error}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Policy overrides by policy",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (policy) (rate(decisionos_policy_overrides_total[5m]))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request latency p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(decisionos_http_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    }
  ]
}
